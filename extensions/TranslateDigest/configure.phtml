<script>
(function () {
    var ajaxUrl = <?php echo json_encode(_url('extension', 'configure', 'e', urlencode($this->getName())), JSON_UNESCAPED_SLASHES); ?>;

    function setStatus(service, text, cls) {
        var el = document.querySelector('.fetch-status[data-service="' + service + '"]');
        if (!el) { return; }
        el.textContent = text;
        el.className = 'help-text fetch-status' + (cls ? ' ' + cls : '');
    }

    function fillDatalist(listId, models) {
        var list = document.getElementById(listId);
        if (!list) { return; }
        list.innerHTML = '';
        models.forEach(function (m) {
            var opt = document.createElement('option');
            opt.value = m;
            list.appendChild(opt);
        });
    }

    document.querySelectorAll('.fetch-models').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var service = btn.dataset.service;
            var targetId = btn.dataset.target;
            var listId = btn.dataset.list;
            var keyEl = document.getElementById(btn.dataset.keyInput || '');
            var epEl = document.getElementById(btn.dataset.endpointInput || '');
            var modelEl = document.getElementById(targetId);

            var params = new URLSearchParams();
            params.set('_action', 'list_models');
            params.set('service', service);
            if (keyEl && keyEl.value) { params.set('api-key', keyEl.value); }
            if (epEl && epEl.value) { params.set('endpoint', epEl.value); }
            if (modelEl && modelEl.value) { params.set('model', modelEl.value); }

            var original = btn.textContent;
            btn.disabled = true;
            btn.textContent = '获取中...';
            setStatus(service, '', '');

            fetch(ajaxUrl + (ajaxUrl.indexOf('?') === -1 ? '?' : '&') + params.toString(), {
                credentials: 'same-origin',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data && data.success && data.models && data.models.length) {
                        fillDatalist(listId, data.models);
                        setStatus(service, '✓ ' + (data.message || ('共 ' + data.models.length + ' 个模型')) + '，点击输入框选择', 'ok');
                    } else {
                        setStatus(service, '✗ ' + ((data && data.message) || '获取失败'), 'err');
                    }
                })
                .catch(function (err) {
                    setStatus(service, '✗ 请求失败: ' + err.message, 'err');
                })
                .finally(function () {
                    btn.disabled = false;
                    btn.textContent = original;
                });
        });
    });
})();
</script>
