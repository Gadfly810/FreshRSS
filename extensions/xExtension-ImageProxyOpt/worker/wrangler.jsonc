{
	// Deploy:  ./deploy.sh      (reads the custom domain from domain.local, which is gitignored)
	// Token:   pnpx wrangler secret put IMAGE_PROXY_TOKEN
	//
	// The custom domain is deliberately NOT in this file: it lives in domain.local so that a
	// public fork of this repository does not advertise someone's private endpoint.
	// Do not run a bare `wrangler deploy` -- with workers_dev off and no routes here, it would
	// drop the custom domain binding and leave the worker unreachable.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "freshrss-image-proxy",
	"main": "worker.js",
	"compatibility_date": "2025-09-01",
	"workers_dev": false,
	"preview_urls": false

	// No `vars`: the shared secret (IMAGE_PROXY_TOKEN) is an HMAC signing key, so it is the only
	// access control and must stay a secret -- `wrangler secret put`, never a var.
}
